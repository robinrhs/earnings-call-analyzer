# The tool reads the key from the environment only; it never writes it anywhere and
# does not load .env files by itself. Either export the key in your shell:
#   export ANTHROPIC_API_KEY=...
# or copy this file to .env (git-ignored), fill it in and load it into the shell:
#   set -a; source .env; set +a
ANTHROPIC_API_KEY=
# Optional: override the default model
# ECA_MODEL=claude-opus-5-5
